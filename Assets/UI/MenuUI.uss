.root {
    flex-grow: 1;
}

.screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    display: none;
}

.screen--active {
    display: flex;
}

.screen--opaque {
    background-color: rgb(255, 248, 238);
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.screen--hud {
    padding: 16px;
}

.title {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(240, 90, 80);
    -unity-text-align: middle-center;
}

.subtitle {
    font-size: 24px;
    color: rgb(120, 110, 100);
    margin-bottom: 40px;
    -unity-text-align: middle-center;
}

.header {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(60, 55, 50);
    margin-left: 16px;
    -unity-text-align: middle-left;
}

.btn {
    min-width: 260px;
    height: 72px;
    margin: 8px;
    font-size: 28px;
    color: rgb(60, 55, 50);
    background-color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 36px;
    transition-duration: 0.12s;
    transition-property: scale, background-color;
}

.btn:hover {
    background-color: rgb(250, 238, 225);
}

.btn:active {
    scale: 0.95 0.95;
}

.btn--primary {
    background-color: rgb(240, 90, 80);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.btn--primary:hover {
    background-color: rgb(225, 75, 65);
}

.btn--small {
    min-width: 0;
    height: 56px;
    padding: 0 24px;
    font-size: 22px;
    margin: 0;
}

.top-bar {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin-bottom: 16px;
}

.top-bar--hud {
    margin-bottom: 0;
}

.spacer {
    flex-grow: 1;
}

.picture-scroll {
    flex-grow: 1;
    align-self: stretch;
}

.picture-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.picture-card {
    width: 220px;
    height: 220px;
    margin: 10px;
    border-radius: 20px;
    background-color: rgb(255, 255, 255);
    -unity-background-scale-mode: scale-to-fit;
    border-width: 4px;
    border-color: rgb(255, 255, 255);
    transition-duration: 0.12s;
    transition-property: scale, border-color;
}

.picture-card:hover {
    border-color: rgb(240, 90, 80);
}

.picture-card:active {
    scale: 0.95 0.95;
}

.palette-scroll {
    flex-grow: 0;
    align-self: stretch;
    background-color: rgba(255, 255, 255, 0.92);
    border-radius: 44px;
    padding: 8px;
}

.palette {
    flex-direction: row;
    align-items: center;
}

.swatch {
    width: 64px;
    height: 64px;
    margin: 6px;
    border-radius: 32px;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0.1);
    transition-duration: 0.12s;
    transition-property: scale, border-color;
}

.swatch--selected {
    border-color: rgb(60, 55, 50);
    scale: 1.15 1.15;
}
